# Cartella /orbis/ su Altervista: niente accesso a file di servizio.
<FilesMatch "^(config\.php|config\.example\.php|\.ftp-deploy-sync-state\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
