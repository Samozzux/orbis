<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:glass="Orbis.UI.Glass" xmlns:el="Orbis.UI.Elements">
    <!-- Interfaccia di avvio di Orbis. I testi "#chiave" vengono dalla tabella Localization "UI". -->
    <Style src="project://database/Assets/Orbis/UI/Uss/Orbis.uss" />
    <ui:VisualElement name="app" class="app">
        <glass:GlassBackdropElement name="backdrop" class="backdrop" />
        <ui:VisualElement name="vignette" class="vignette" picking-mode="Ignore" />
        <ui:VisualElement name="safe-area" class="safe-area" picking-mode="Ignore">

            <ui:VisualElement name="splash" class="screen splash">
                <el:OrbisLogo class="logo logo--splash" />
                <ui:Label class="wordmark wordmark--splash" text="#app.title" />
                <ui:Label class="tagline tagline--splash" text="#app.tagline" />
            </ui:VisualElement>

            <ui:VisualElement name="loading" class="screen loading">
                <ui:VisualElement class="loading__center">
                    <el:OrbisLogo class="logo logo--loading" />
                    <ui:Label class="wordmark wordmark--loading" text="#app.title" />
                    <ui:VisualElement class="progress">
                        <glass:GlassSurface />
                        <ui:VisualElement class="progress__track">
                            <ui:VisualElement name="progress-fill" class="progress__fill">
                                <ui:VisualElement class="progress__shine" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="loading__row">
                        <ui:Label name="loading-status" class="loading__status" text="" />
                        <ui:Label name="loading-percent" class="loading__percent" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="tip">
                    <glass:GlassSurface />
                    <ui:Label class="tip__title" text="#loading.tip_title" picking-mode="Ignore" />
                    <ui:Label name="tip-text" class="tip__text" text="" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="menu" class="screen menu">
                <ui:VisualElement class="menu__content">
                    <ui:VisualElement class="menu__hero">
                        <el:OrbisLogo class="logo logo--hero" />
                        <ui:VisualElement class="menu__titles">
                            <ui:Label class="wordmark wordmark--hero" text="#app.title" />
                            <ui:Label class="tagline" text="#app.tagline" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="menu__actions">
                        <ui:Button name="btn-new-game" class="game-button game-button--primary">
                            <glass:GlassSurface />
                            <ui:VisualElement class="game-button__badge" picking-mode="Ignore">
                                <el:OrbisIcon icon="Plus" class="game-button__icon" />
                            </ui:VisualElement>
                            <ui:VisualElement class="game-button__texts" picking-mode="Ignore">
                                <ui:Label class="game-button__label" text="#menu.new_game" picking-mode="Ignore" />
                                <ui:Label class="game-button__detail" text="#menu.new_game.detail" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:Button>
                        <ui:Button name="btn-continue" class="game-button game-button--secondary">
                            <glass:GlassSurface />
                            <ui:VisualElement class="game-button__badge" picking-mode="Ignore">
                                <el:OrbisIcon icon="Play" class="game-button__icon" />
                            </ui:VisualElement>
                            <ui:VisualElement class="game-button__texts" picking-mode="Ignore">
                                <ui:Label class="game-button__label" text="#menu.continue" picking-mode="Ignore" />
                                <ui:Label name="continue-detail" class="game-button__detail" text="" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="navbar">
                    <glass:GlassSurface />
                    <ui:Button name="nav-account" class="nav-item nav-item--friends">
                        <ui:VisualElement class="nav-item__badge" picking-mode="Ignore">
                            <ui:VisualElement class="candy-face" picking-mode="Ignore">
                                <el:OrbisIcon icon="User" class="nav-item__icon" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label name="nav-account-label" class="nav-item__label" text="#menu.account" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="nav-settings" class="nav-item nav-item--settings">
                        <ui:VisualElement class="nav-item__badge" picking-mode="Ignore">
                            <ui:VisualElement class="candy-face" picking-mode="Ignore">
                                <el:OrbisIcon icon="Settings" class="nav-item__icon" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label class="nav-item__label" text="#menu.settings" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="nav-credits" class="nav-item nav-item--credits">
                        <ui:VisualElement class="nav-item__badge" picking-mode="Ignore">
                            <ui:VisualElement class="candy-face" picking-mode="Ignore">
                                <el:OrbisIcon icon="Info" class="nav-item__icon" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label class="nav-item__label" text="#menu.credits" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>

                <ui:Label name="version" class="version" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement name="game" class="screen game" picking-mode="Ignore">
                <ui:VisualElement class="hud-top" picking-mode="Ignore">
                    <ui:Button name="hud-home" class="hud-button">
                        <glass:GlassSurface />
                        <el:OrbisIcon icon="Home" class="hud-button__icon" />
                    </ui:Button>
                    <ui:VisualElement name="hud-clock" class="hud-clock">
                        <glass:GlassSurface />
                        <el:OrbisIcon name="hud-weather-icon" icon="Sun" class="hud-clock__weather" />
                        <ui:VisualElement class="hud-clock__texts" picking-mode="Ignore">
                            <ui:Label name="hud-time" class="hud-clock__time" text="" picking-mode="Ignore" />
                            <ui:Label name="hud-weather" class="hud-clock__detail" text="" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Button name="hud-speed" class="hud-speed">
                            <ui:VisualElement class="candy-face" picking-mode="Ignore">
                                <el:OrbisIcon name="hud-speed-icon" icon="Play" class="hud-speed__icon" />
                                <ui:Label name="hud-speed-label" class="hud-speed__label" text="1×" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="hud-side" picking-mode="Ignore">
                        <ui:Button name="hud-view" class="hud-button">
                            <glass:GlassSurface />
                            <el:OrbisIcon name="hud-view-icon" icon="Map" class="hud-button__icon" />
                        </ui:Button>
                        <ui:Button name="hud-north" class="hud-button">
                            <glass:GlassSurface />
                            <el:OrbisIcon name="hud-north-icon" icon="Compass" class="hud-button__icon" />
                        </ui:Button>
                        <ui:Button name="hud-layers" class="hud-button">
                            <glass:GlassSurface />
                            <el:OrbisIcon icon="Layers" class="hud-button__icon" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="hud-economy" class="hud-economy" picking-mode="Ignore">
                    <ui:VisualElement name="hud-cash" class="hud-pill" picking-mode="Ignore">
                        <glass:GlassSurface />
                        <el:OrbisIcon icon="Coins" class="hud-pill__icon hud-pill__icon--coins" />
                        <ui:Label name="hud-cash-value" class="hud-pill__value" text="" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="hud-level" class="hud-pill hud-pill--level" picking-mode="Ignore">
                        <glass:GlassSurface />
                        <el:OrbisIcon icon="Star" class="hud-pill__icon hud-pill__icon--star" />
                        <ui:Label name="hud-level-value" class="hud-pill__value" text="" picking-mode="Ignore" />
                        <ui:VisualElement class="xp-bar" picking-mode="Ignore">
                            <ui:VisualElement name="hud-xp-fill" class="xp-bar__fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <!-- la missione sta nella stessa colonna di cassa e livello: la distanza resta sempre quella -->
                    <ui:Button name="mission-card" class="mission-card">
                        <glass:GlassSurface />
                        <el:OrbisIcon icon="Flag" class="mission-card__icon" />
                        <ui:VisualElement class="mission-card__texts" picking-mode="Ignore">
                            <ui:Label name="mission-title" class="mission-card__title" text="" picking-mode="Ignore" />
                            <ui:Label name="mission-text" class="mission-card__text" text="" picking-mode="Ignore" />
                            <ui:VisualElement class="xp-bar mission-card__bar" picking-mode="Ignore">
                                <ui:VisualElement name="mission-fill" class="xp-bar__fill mission-card__fill" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:Button>
                </ui:VisualElement>

                <ui:VisualElement name="hud-actions" class="hud-actions" picking-mode="Ignore">
                    <ui:Button name="hud-undo" class="hud-button">
                        <glass:GlassSurface />
                        <el:OrbisIcon icon="Undo" class="hud-button__icon" />
                    </ui:Button>
                    <ui:Button name="hud-redo" class="hud-button">
                        <glass:GlassSurface />
                        <el:OrbisIcon icon="Redo" class="hud-button__icon" />
                    </ui:Button>
                    <ui:Button name="hud-build" class="hud-build">
                        <glass:GlassSurface />
                        <el:OrbisIcon icon="Building" class="hud-build__icon" />
                        <ui:Label class="hud-build__label" text="#build.open" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="hud-finance" class="hud-button">
                        <glass:GlassSurface />
                        <el:OrbisIcon icon="Chart" class="hud-button__icon" />
                    </ui:Button>
                    <ui:Button name="hud-rewind" class="hud-button">
                        <glass:GlassSurface />
                        <el:OrbisIcon icon="Rewind" class="hud-button__icon" />
                    </ui:Button>
                </ui:VisualElement>

                <ui:VisualElement name="build-bar" class="build-bar">
                    <glass:GlassSurface />
                    <ui:VisualElement class="build-bar__texts" picking-mode="Ignore">
                        <ui:Label name="build-name" class="build-bar__name" text="" picking-mode="Ignore" />
                        <ui:Label name="build-info" class="build-bar__info" text="" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Button name="build-rotate" class="round-button round-button--blue">
                        <ui:VisualElement class="candy-face" picking-mode="Ignore">
                            <el:OrbisIcon icon="Rotate" class="round-button__icon" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="build-confirm" class="round-button round-button--green">
                        <ui:VisualElement class="candy-face" picking-mode="Ignore">
                            <el:OrbisIcon icon="Check" class="round-button__icon" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="build-cancel" class="round-button round-button--red">
                        <ui:VisualElement class="candy-face" picking-mode="Ignore">
                            <el:OrbisIcon icon="Close" class="round-button__icon" />
                        </ui:VisualElement>
                    </ui:Button>
                </ui:VisualElement>

                <ui:VisualElement name="game-toast" class="game-toast" picking-mode="Ignore">
                    <glass:GlassSurface />
                    <ui:Label name="game-toast-text" class="game-toast__text" text="" picking-mode="Ignore" />
                </ui:VisualElement>

                <ui:VisualElement name="layers" class="layers">
                    <glass:GlassSurface />
                    <ui:Button name="toggle-streets" class="setting-row layers__row">
                        <ui:VisualElement class="setting-row__texts" picking-mode="Ignore">
                            <ui:Label class="setting-row__label" text="#game.layers.streets" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement name="streets-switch" class="switch" picking-mode="Ignore">
                            <ui:VisualElement class="switch__knob" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="toggle-lots" class="setting-row layers__row">
                        <ui:VisualElement class="setting-row__texts" picking-mode="Ignore">
                            <ui:Label class="setting-row__label" text="#game.layers.lots" picking-mode="Ignore" />
                            <ui:Label class="setting-row__detail" text="#game.layers.lots.detail" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement name="lots-switch" class="switch" picking-mode="Ignore">
                            <ui:VisualElement class="switch__knob" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:Button>
                </ui:VisualElement>

                <ui:VisualElement name="world-loading" class="world-loading" picking-mode="Ignore">
                    <glass:GlassSurface />
                    <el:OrbisIcon icon="Globe" class="world-loading__icon" />
                    <ui:Label name="world-loading-text" class="world-loading__text" text="" picking-mode="Ignore" />
                </ui:VisualElement>

                <ui:VisualElement name="details" class="details">
                    <glass:GlassSurface />
                    <ui:VisualElement class="details__header">
                        <ui:VisualElement class="details__badge" picking-mode="Ignore">
                            <ui:VisualElement class="candy-face" picking-mode="Ignore">
                                <el:OrbisIcon icon="Building" class="details__badge-icon" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="details__titles" picking-mode="Ignore">
                            <ui:Label name="details-title" class="details__title" text="" picking-mode="Ignore" />
                            <ui:Label name="details-subtitle" class="details__subtitle" text="" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Button name="details-close" class="icon-button">
                            <ui:VisualElement class="candy-face" picking-mode="Ignore">
                                <el:OrbisIcon icon="Close" class="icon-button__icon" />
                            </ui:VisualElement>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement name="details-actions" class="details__actions" />
                    <ui:ScrollView name="details-scroll" class="details__scroll">
                        <ui:VisualElement name="details-rows" class="details__rows" />
                    </ui:ScrollView>
                    <ui:Label class="details__attribution" text="#details.attribution" picking-mode="Ignore" />
                </ui:VisualElement>

                <ui:Label name="hud-attribution" class="hud-attribution" text="© OpenStreetMap" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement name="settings" class="sheet-layer">
                <ui:VisualElement name="settings-scrim" class="scrim" />
                <ui:VisualElement class="sheet">
                    <glass:GlassSurface />
                    <ui:VisualElement class="sheet__header">
                        <ui:Label class="sheet__title" text="#settings.title" />
                        <ui:Button name="settings-close" class="icon-button">
                            <ui:VisualElement class="candy-face" picking-mode="Ignore">
                                <el:OrbisIcon icon="Close" class="icon-button__icon" />
                            </ui:VisualElement>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:Label class="sheet__section" text="#settings.section.screen" />
                    <ui:VisualElement name="orientation-controls" class="settings-group">
                        <ui:Button name="toggle-autorotate" class="setting-row">
                            <ui:VisualElement class="setting-row__texts" picking-mode="Ignore">
                                <ui:Label class="setting-row__label" text="#settings.autorotate" picking-mode="Ignore" />
                                <ui:Label class="setting-row__detail" text="#settings.autorotate.detail" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="autorotate-switch" class="switch" picking-mode="Ignore">
                                <ui:VisualElement class="switch__knob" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:Button>
                        <ui:VisualElement name="orientation-row" class="setting-row setting-row--choice">
                            <ui:VisualElement class="setting-row__texts" picking-mode="Ignore">
                                <ui:Label class="setting-row__label" text="#settings.orientation" picking-mode="Ignore" />
                                <ui:Label class="setting-row__detail setting-row__detail--when-disabled" text="#settings.orientation.detail" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="segmented">
                                <ui:Button name="orientation-portrait" class="segmented__item">
                                    <el:OrbisIcon icon="PhonePortrait" class="segmented__icon" />
                                    <ui:Label class="segmented__label" text="#settings.orientation.portrait" picking-mode="Ignore" />
                                </ui:Button>
                                <ui:Button name="orientation-landscape" class="segmented__item">
                                    <el:OrbisIcon icon="PhoneLandscape" class="segmented__icon" />
                                    <ui:Label class="segmented__label" text="#settings.orientation.landscape" picking-mode="Ignore" />
                                </ui:Button>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="orientation-note" class="sheet__note" text="#settings.orientation.web_note" />
                    <ui:Label class="sheet__note sheet__note--muted" text="#settings.more_soon" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="panel" class="sheet-layer">
                <ui:VisualElement name="panel-scrim" class="scrim" />
                <ui:VisualElement class="sheet sheet--panel">
                    <glass:GlassSurface />
                    <ui:VisualElement class="sheet__header">
                        <ui:Label name="panel-title" class="sheet__title" text="" />
                        <ui:Button name="panel-close" class="icon-button">
                            <ui:VisualElement class="candy-face" picking-mode="Ignore">
                                <el:OrbisIcon icon="Close" class="icon-button__icon" />
                            </ui:VisualElement>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:ScrollView name="panel-tabs-scroll" class="panel-tabs-scroll" mode="Horizontal">
                        <ui:VisualElement name="panel-tabs" class="panel-tabs" />
                    </ui:ScrollView>
                    <ui:ScrollView name="panel-scroll" class="panel-scroll">
                        <ui:VisualElement name="panel-content" class="panel-content" />
                    </ui:ScrollView>
                    <ui:VisualElement name="panel-footer" class="panel-footer" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="toast" class="toast" picking-mode="Ignore">
                <glass:GlassSurface />
                <el:OrbisIcon icon="Info" class="toast__icon" />
                <ui:Label name="toast-text" class="toast__text" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
