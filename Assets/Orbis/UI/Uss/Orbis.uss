/*
 * Orbis — stile dell'interfaccia: da gioco, colorato e "cicciotto", con bottoni e navbar in liquid glass.
 * 1 px USS = 1 punto logico (vedi AdaptiveLayout). Classi di layout sull'elemento .app:
 * layout-compact (telefono), layout-medium (tablet), layout-wide (desktop), orientation-portrait,
 * input-touch / input-pointer.
 * Nota: il progetto è in spazio colore lineare, quindi le velature bianche semitrasparenti schiariscono
 * molto: per questo le tinte bianche del vetro hanno alfa bassa.
 */

/* ---------- Base ---------- */

.app {
    flex-grow: 1;
    color: rgb(255, 255, 255);
    font-size: 15px;
}

.backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    transition-property: opacity;
    transition-duration: 1.2s;
    transition-timing-function: ease-in-out-sine;
}

/* quando la città 3D è pronta lo sfondo fisso sfuma e la si vede */
.backdrop--hidden {
    opacity: 0;
}

.vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.safe-area {
    flex-grow: 1;
}

.app Label {
    padding: 0;
    margin: 0;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

/* font da gioco (Lilita One, OFL) per titoli, bottoni ed etichette */
.wordmark,
.game-button__label,
.nav-item__label,
.toast__text,
.loading__percent,
.tip__title,
.sheet__title,
.sheet__section,
.setting-row__label,
.segmented__label {
    -unity-font-definition: url("project://database/Assets/Orbis/UI/Fonts/LilitaOne/LilitaOne-Regular.ttf");
    -unity-font-style: normal;
}

/* ---------- Schermate e transizioni ---------- */

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-cubic;
}

.screen--visible {
    opacity: 1;
}

/* ---------- Logo e marchio ---------- */

.logo {
    flex-shrink: 0;
    --logo-color: rgb(255, 255, 255);
    --logo-accent: rgb(255, 196, 60);
    --logo-fill: rgba(10, 40, 90, 0.55);
}

.wordmark {
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2.5px;
    -unity-text-outline-color: rgb(16, 52, 120);
    text-shadow: 0 4px 0 rgba(10, 30, 80, 0.75);
    letter-spacing: 1px;
}

.tagline {
    font-size: 16px;
    -unity-font-style: bold;
    margin-top: 2px;
    -unity-text-outline-width: 1.2px;
    -unity-text-outline-color: rgba(10, 30, 80, 0.85);
    text-shadow: 0 2px 4px rgba(0, 10, 40, 0.6);
}

/* ---------- Logo iniziale ---------- */

.splash {
    align-items: center;
    justify-content: center;
}

.logo--splash {
    width: 176px;
    height: 176px;
    scale: 0.6 0.6;
    transition-property: scale;
    transition-duration: 0.9s;
    transition-timing-function: ease-out-back;
}

.splash.screen--visible .logo--splash {
    scale: 1 1;
}

.wordmark--splash {
    font-size: 72px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 3px;
}

.tagline--splash {
    -unity-text-align: middle-center;
    font-size: 18px;
}

/* ---------- Caricamento ---------- */

.loading {
    align-items: center;
    justify-content: center;
}

.loading__center {
    align-items: center;
}

.logo--loading {
    width: 112px;
    height: 112px;
}

.wordmark--loading {
    font-size: 48px;
    -unity-text-align: middle-center;
}

.progress {
    width: 320px;
    height: 30px;
    margin-top: 22px;
    padding: 6px;
}

.progress > .glass-fill {
    --glass-tint-top: rgba(8, 30, 80, 0.45);
    --glass-tint-bottom: rgba(8, 30, 80, 0.55);
    --glass-lip: rgba(0, 18, 50, 0.45);
    --glass-lip-height: 3;
    --glass-shadow-spread: 10;
    --glass-shadow-offset: 4;
}

.progress__track {
    flex-grow: 1;
    border-radius: 999px;
    overflow: hidden;
}

.progress__fill {
    width: 0;
    height: 100%;
    border-radius: 999px;
    background-color: rgb(255, 160, 30);
    border-bottom-width: 3px;
    border-color: rgb(214, 104, 8);
}

.progress__shine {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 3px;
    height: 35%;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.35);
}

.loading__row {
    flex-direction: row;
    justify-content: space-between;
    width: 308px;
    margin-top: 10px;
}

.loading__status {
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(10, 30, 80, 0.8);
}

.loading__percent {
    font-size: 18px;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(16, 52, 120);
}

.tip {
    position: absolute;
    bottom: 24px;
    align-self: center;
    max-width: 560px;
    padding: 12px 22px 14px 22px;
    align-items: center;
}

.tip > .glass-fill {
    border-radius: 22px;
    --glass-tint-top: rgba(8, 30, 80, 0.60);
    --glass-tint-bottom: rgba(8, 30, 80, 0.72);
}

.tip__title {
    font-size: 16px;
    color: rgb(255, 210, 80);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1.2px;
    -unity-text-outline-color: rgb(120, 60, 0);
}

.app .tip__text {
    font-size: 14px;
    margin-top: 3px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ---------- Menu principale ---------- */

.menu {
    padding: 20px 40px 104px 40px;
}

.menu__content {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.menu__hero {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    translate: -30px 0;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.8s, 0.6s;
    transition-timing-function: ease-out-back, ease-out-cubic;
}

.menu.screen--visible .menu__hero {
    translate: 0 0;
    opacity: 1;
}

.logo--hero {
    width: 120px;
    height: 120px;
    margin-right: 6px;
}

.wordmark--hero {
    font-size: 68px;
}

.menu__actions {
    width: 310px;
    flex-shrink: 0;
    translate: 0 40px;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.75s, 0.5s;
    transition-delay: 0.1s, 0.1s;
    transition-timing-function: ease-out-back, ease-out-cubic;
}

.menu.screen--visible .menu__actions {
    translate: 0 0;
    opacity: 1;
}

/* ---------- Superfici di vetro ---------- */

.glass-fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 999px;
    --glass-tint-top: rgba(255, 255, 255, 0.06);
    --glass-tint-bottom: rgba(255, 255, 255, 0);
    --glass-rim-top: rgba(255, 255, 255, 0.75);
    --glass-rim-bottom: rgba(255, 255, 255, 0.10);
    --glass-rim-width: 1.6;
    --glass-shadow: rgba(0, 10, 40, 0.35);
    --glass-shadow-spread: 14;
    --glass-shadow-offset: 8;
    --glass-lip: rgba(0, 0, 0, 0);
    --glass-lip-height: 0;
}

/* ---------- Bottoni da gioco (capsule di vetro colorato con spessore) ---------- */

.game-button.unity-button,
.game-button.unity-button:hover,
.game-button.unity-button:active,
.game-button.unity-button:focus,
.game-button.unity-button:disabled {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 999px;
    margin: 0 0 18px 0;
    padding: 0 24px 0 10px;
    height: 74px;
    flex-direction: row;
    align-items: center;
    -unity-text-align: middle-left;
    color: rgb(255, 255, 255);
    opacity: 1; /* il tema di Unity rende semitrasparente il bottone disattivato: qui si attenua solo il contenuto */
}

.game-button {
    transition-property: scale, translate;
    transition-duration: 0.18s, 0.08s;
    transition-timing-function: ease-out-back, ease-out-cubic;
}

.input-pointer .game-button:hover {
    scale: 1.04 1.04;
}

.game-button:active {
    scale: 0.97 0.97;
    translate: 0 4px;
}

.game-button > .glass-fill {
    --glass-lip-height: 6;
}

.game-button:active > .glass-fill {
    --glass-lip-height: 2;
}

/* disattivato: il vetro resta, si attenua solo il contenuto */
.game-button:disabled > .game-button__badge,
.game-button:disabled > .game-button__texts {
    opacity: 0.62;
}

.input-pointer .game-button:focus > .glass-fill {
    --glass-rim-top: rgba(255, 255, 255, 1);
    --glass-rim-bottom: rgba(255, 255, 255, 0.7);
    --glass-rim-width: 3;
}

/* principale: arancio dorato */
.game-button--primary > .glass-fill {
    --glass-tint-top: rgba(255, 200, 50, 0.93);
    --glass-tint-bottom: rgba(255, 128, 20, 0.90);
    --glass-rim-top: rgba(255, 255, 255, 0.95);
    --glass-rim-bottom: rgba(255, 220, 160, 0.35);
    --glass-lip: rgb(196, 86, 8);
    --glass-shadow: rgba(120, 50, 0, 0.45);
}

.input-pointer .game-button--primary:hover > .glass-fill {
    --glass-tint-top: rgba(255, 214, 80, 0.96);
    --glass-tint-bottom: rgba(255, 142, 30, 0.93);
}

/* secondario: blu cielo */
.game-button--secondary > .glass-fill {
    --glass-tint-top: rgba(50, 160, 255, 0.90);
    --glass-tint-bottom: rgba(20, 100, 235, 0.88);
    --glass-lip: rgb(14, 66, 160);
}

.game-button__badge {
    width: 52px;
    height: 52px;
    border-radius: 26px;
    margin-right: 14px;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.28);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.75);
}

.game-button__icon {
    width: 24px;
    height: 24px;
    color: rgb(255, 255, 255);
}

.game-button__texts {
    flex-grow: 1;
    justify-content: center;
}

.game-button__label {
    font-size: 26px;
    -unity-text-outline-width: 1.6px;
    -unity-text-outline-color: rgba(90, 40, 0, 0.85);
    text-shadow: 0 2px 0 rgba(90, 40, 0, 0.55);
}

.game-button--secondary .game-button__label {
    -unity-text-outline-color: rgba(10, 40, 110, 0.9);
    text-shadow: 0 2px 0 rgba(10, 40, 110, 0.55);
}

.game-button__detail {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.92);
    margin-top: 0;
}

/* ---------- Navbar fluttuante ---------- */

.navbar {
    position: absolute;
    bottom: 16px;
    align-self: center;
    flex-direction: row;
    padding: 6px 10px 8px 10px;
    translate: 0 60px;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.8s, 0.5s;
    transition-delay: 0.2s, 0.2s;
    transition-timing-function: ease-out-back, ease-out-cubic;
}

.navbar > .glass-fill {
    border-radius: 30px;
    /* vetro fumé: le etichette bianche restano leggibili anche sopra la città chiara */
    --glass-tint-top: rgba(8, 30, 80, 0.60);
    --glass-tint-bottom: rgba(8, 30, 80, 0.72);
    --glass-lip: rgba(0, 20, 60, 0.55);
    --glass-lip-height: 4;
}

.menu.screen--visible .navbar {
    translate: 0 0;
    opacity: 1;
}

.nav-item.unity-button,
.nav-item.unity-button:hover,
.nav-item.unity-button:active,
.nav-item.unity-button:focus {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 20px;
    margin: 0 2px;
    padding: 4px 0 2px 0;
    width: 96px;
    height: 74px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: rgb(255, 255, 255);
}

.nav-item {
    transition-property: scale, translate;
    transition-duration: 0.18s, 0.08s;
    transition-timing-function: ease-out-back, ease-out-cubic;
}

.input-pointer .nav-item:hover {
    scale: 1.08 1.08;
}

.input-pointer .nav-item.unity-button:focus {
    background-color: rgba(255, 255, 255, 0.07);
}

.nav-item:active {
    scale: 0.92 0.92;
    translate: 0 2px;
}

/* Bottoni e badge "caramella": anello bianco uniforme (sfondo + padding dell'elemento) attorno a una faccia
   colorata con il bordino scuro in basso (.candy-face, elemento figlio). L'anello non si interrompe più agli
   angoli e il contenuto della faccia è sempre centrato. */
.candy-face {
    flex-grow: 1;
    align-self: stretch;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-bottom-width: 4px;
}

.nav-item__badge {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    padding: 2px;
    background-color: rgba(255, 255, 255, 0.85);
}

.nav-item__badge > .candy-face { border-radius: 20px; }
.nav-item--friends .nav-item__badge > .candy-face { background-color: rgb(52, 199, 89); border-color: rgb(28, 128, 54); }
.nav-item--settings .nav-item__badge > .candy-face { background-color: rgb(175, 82, 222); border-color: rgb(110, 44, 150); }
.nav-item--credits .nav-item__badge > .candy-face { background-color: rgb(255, 159, 10); border-color: rgb(196, 100, 0); }

.nav-item__icon {
    width: 22px;
    height: 22px;
    color: rgb(255, 255, 255);
}

.nav-item__label {
    font-size: 13px;
    margin-top: 4px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1.2px;
    -unity-text-outline-color: rgba(10, 30, 80, 0.85);
}

/* ---------- Avviso (toast) ---------- */

.toast {
    position: absolute;
    top: 14px;
    align-self: center;
    flex-direction: row;
    align-items: center;
    height: 50px;
    padding: 0 22px 0 16px;
    opacity: 0;
    translate: 0 -40px;
    scale: 0.8 0.8;
    transition-property: opacity, translate, scale;
    transition-duration: 0.25s, 0.5s, 0.5s;
    transition-timing-function: ease-out-cubic, ease-out-back, ease-out-back;
}

.toast--visible {
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
}

.toast > .glass-fill {
    --glass-tint-top: rgba(255, 200, 50, 0.92);
    --glass-tint-bottom: rgba(255, 140, 20, 0.88);
    --glass-lip: rgb(196, 86, 8);
    --glass-lip-height: 4;
}

.toast__icon {
    width: 22px;
    height: 22px;
    margin-right: 10px;
    color: rgb(255, 255, 255);
}

.toast__text {
    font-size: 18px;
    -unity-text-outline-width: 1.4px;
    -unity-text-outline-color: rgba(90, 40, 0, 0.85);
}

/* ---------- Pannello Impostazioni ---------- */

.sheet-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-cubic;
}

.sheet-layer--visible {
    opacity: 1;
}

.scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 8, 30, 0.62);
}

.sheet {
    width: 520px;
    max-width: 92%;
    max-height: 92%;
    padding: 18px 22px 22px 22px;
    scale: 0.88 0.88;
    transition-property: scale;
    transition-duration: 0.45s;
    transition-timing-function: ease-out-back;
}

.sheet-layer--visible .sheet {
    scale: 1 1;
}

.sheet > .glass-fill {
    border-radius: 30px;
    --glass-tint-top: rgba(8, 30, 80, 0.84);
    --glass-tint-bottom: rgba(8, 30, 80, 0.90);
    --glass-lip: rgba(0, 16, 50, 0.6);
    --glass-lip-height: 6;
}

.sheet__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

.sheet__title {
    font-size: 30px;
    -unity-text-outline-width: 1.6px;
    -unity-text-outline-color: rgb(16, 52, 120);
}

.icon-button.unity-button,
.icon-button.unity-button:hover,
.icon-button.unity-button:active,
.icon-button.unity-button:focus {
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 2px;
    border-width: 0;
    border-radius: 22px;
    background-color: rgba(255, 255, 255, 0.85);
}

.icon-button > .candy-face { border-radius: 20px; background-color: rgb(235, 72, 56); border-color: rgb(150, 40, 30); }

.icon-button {
    transition-property: scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-back;
}

.icon-button:active {
    scale: 0.9 0.9;
}

.icon-button__icon {
    width: 18px;
    height: 18px;
    color: rgb(255, 255, 255);
}

.sheet__section {
    font-size: 17px;
    color: rgb(255, 210, 80);
    margin: 8px 0 8px 4px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(120, 60, 0);
}

.settings-group {
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.07);
    padding: 4px 0;
}

.setting-row.unity-button,
.setting-row.unity-button:hover,
.setting-row.unity-button:active,
.setting-row.unity-button:focus,
.setting-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    margin: 0;
    padding: 8px 16px;
    border-width: 0;
    border-radius: 18px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(255, 255, 255);
}

.input-pointer .setting-row.unity-button:hover,
.input-pointer .setting-row.unity-button:focus {
    background-color: rgba(255, 255, 255, 0.06);
}

.setting-row__texts {
    flex-shrink: 1;
    margin-right: 12px;
}

.setting-row__label {
    font-size: 19px;
}

.app .setting-row__detail {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.75);
    white-space: normal;
    margin-top: 1px;
}

/* il suggerimento "spegni la rotazione per scegliere" si vede solo quando la scelta è disattivata */
.setting-row__detail--when-disabled {
    display: none;
}

.setting-row--choice:disabled .setting-row__detail--when-disabled {
    display: flex;
}

.setting-row--choice:disabled .segmented {
    opacity: 0.45;
}

.setting-row--choice:disabled {
    opacity: 1;
}

/* interruttore a capsula */
.switch {
    width: 60px;
    height: 34px;
    border-radius: 17px;
    flex-shrink: 0;
    padding: 3px;
    background-color: rgba(255, 255, 255, 0.22);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.5);
    transition-property: background-color;
    transition-duration: 0.2s;
}

.switch--on {
    background-color: rgb(52, 199, 89);
}

.switch__knob {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background-color: rgb(255, 255, 255);
    border-bottom-width: 2px;
    border-color: rgba(0, 0, 0, 0.2);
    transition-property: translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
}

.switch--on .switch__knob {
    translate: 26px 0;
}

/* scelta a segmenti (verticale / orizzontale) */
.segmented {
    flex-direction: row;
    flex-shrink: 0;
    padding: 4px;
    border-radius: 18px;
    background-color: rgba(0, 0, 0, 0.25);
}

.segmented__item.unity-button,
.segmented__item.unity-button:hover,
.segmented__item.unity-button:active,
.segmented__item.unity-button:focus,
.segmented__item.unity-button:disabled {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 92px;
    height: 64px;
    margin: 0;
    padding: 4px 0;
    border-width: 0;
    border-radius: 14px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(255, 255, 255);
}

.segmented__item.unity-button.segmented__item--selected {
    background-color: rgb(255, 160, 30);
    border-bottom-width: 3px;
    border-color: rgb(196, 86, 8);
}

.segmented__icon {
    width: 24px;
    height: 24px;
    color: rgb(255, 255, 255);
}

.segmented__label {
    font-size: 14px;
    margin-top: 2px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(10, 30, 80, 0.8);
}

.app .sheet__note {
    font-size: 14px;
    white-space: normal;
    margin: 12px 6px 0 6px;
    color: rgba(255, 255, 255, 0.9);
}

.app .sheet__note--muted {
    color: rgba(255, 255, 255, 0.6);
    font-size: 13px;
}

/* in verticale le righe vanno a capo: testo sopra, controlli sotto */
.orientation-portrait .setting-row--choice {
    flex-direction: column;
    align-items: flex-start;
}

.orientation-portrait .setting-row--choice .segmented {
    margin-top: 10px;
    align-self: stretch;
}

.orientation-portrait .segmented__item.unity-button {
    flex-grow: 1;
}

/* ---------- Versione ---------- */

.version {
    position: absolute;
    right: 18px;
    bottom: 10px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.75);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}

/* ---------- Tablet ---------- */

.layout-medium .logo--hero { width: 150px; height: 150px; }
.layout-medium .wordmark--hero { font-size: 88px; }
.layout-medium .tagline { font-size: 19px; }
.layout-medium .menu__actions { width: 350px; }
.layout-medium .game-button.unity-button { height: 82px; }
.layout-medium .game-button__label { font-size: 28px; }
.layout-medium .menu { padding: 32px 56px 120px 56px; }
.layout-medium .navbar { bottom: 22px; }
.layout-medium .nav-item.unity-button { width: 108px; height: 80px; }
.layout-medium .nav-item__badge { width: 50px; height: 50px; border-radius: 25px; }
.layout-medium .nav-item__badge > .candy-face { border-radius: 23px; }

/* ---------- Desktop ---------- */

.layout-wide .logo--hero { width: 180px; height: 180px; margin-right: 12px; }
.layout-wide .wordmark--hero { font-size: 112px; -unity-text-outline-width: 3.5px; }
.layout-wide .tagline { font-size: 22px; }
.layout-wide .menu__actions { width: 400px; }
.layout-wide .game-button.unity-button { height: 88px; padding: 0 28px 0 12px; }
.layout-wide .game-button__label { font-size: 32px; }
.layout-wide .game-button__badge { width: 60px; height: 60px; border-radius: 30px; }
.layout-wide .menu { padding: 48px 10% 140px 8%; }
.layout-wide .navbar { bottom: 28px; }
.layout-wide .nav-item.unity-button { width: 116px; height: 84px; }
.layout-wide .nav-item__badge { width: 52px; height: 52px; border-radius: 26px; }
.layout-wide .nav-item__badge > .candy-face { border-radius: 24px; }
.layout-wide .nav-item__label { font-size: 15px; }
.layout-wide .logo--splash { width: 220px; height: 220px; }
.layout-wide .wordmark--splash { font-size: 96px; }

/* ---------- Verticale (browser del telefono, menu nel telefono di gioco) ---------- */

.orientation-portrait .menu { padding: 40px 24px 112px 24px; }
.orientation-portrait .menu__content { flex-direction: column; justify-content: space-between; }
.orientation-portrait .menu__hero { flex-direction: column; translate: 0 -20px; }
.orientation-portrait.app .menu.screen--visible .menu__hero { translate: 0 0; }
.orientation-portrait .logo--hero { margin-right: 0; margin-bottom: 2px; }
.orientation-portrait .menu__titles { align-items: center; }
.orientation-portrait .wordmark--hero { -unity-text-align: middle-center; }
.orientation-portrait .tagline { -unity-text-align: middle-center; }
.orientation-portrait .menu__actions { width: 100%; max-width: 360px; }
.orientation-portrait .version { top: 10px; bottom: auto; }
.orientation-portrait .tip { max-width: 92%; }

/* ======================================================================
   Gioco: HUD sopra il mondo (M1). Stesso vetro e stile del menu.
   ====================================================================== */

.game {
    padding: 14px 14px 14px 14px;
    justify-content: space-between;
}

.hud-top {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
}

.hud-side {
    flex-direction: column;
    align-items: flex-end;
}

.hud-button.unity-button,
.hud-button.unity-button:hover,
.hud-button.unity-button:active,
.hud-button.unity-button:focus {
    width: 52px;
    height: 52px;
    margin: 0 0 10px 0;
    padding: 0;
    border-width: 0;
    border-radius: 26px;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
}

.hud-button {
    transition-property: scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-back;
}

.hud-button:active {
    scale: 0.9 0.9;
}

.input-pointer .hud-button:hover {
    scale: 1.06 1.06;
}

.hud-button > .glass-fill,
.hud-clock > .glass-fill,
.world-loading > .glass-fill {
    --glass-tint-top: rgba(8, 30, 80, 0.55);
    --glass-tint-bottom: rgba(8, 30, 80, 0.70);
    --glass-lip: rgba(0, 16, 50, 0.55);
    --glass-lip-height: 4;
}

.hud-button--on > .glass-fill {
    --glass-tint-top: rgba(50, 160, 255, 0.90);
    --glass-tint-bottom: rgba(20, 100, 235, 0.88);
    --glass-lip: rgb(14, 66, 160);
}

.hud-button__icon {
    width: 24px;
    height: 24px;
    color: rgb(255, 255, 255);
}

.hud-clock {
    flex-direction: row;
    align-items: center;
    height: 52px;
    padding: 0 6px 0 14px;
    margin: 0 10px;
    flex-shrink: 1;
}

.hud-clock__weather {
    width: 26px;
    height: 26px;
    color: rgb(255, 214, 80);
    margin-right: 8px;
}

.hud-clock__texts {
    flex-direction: column;
    margin-right: 8px;
}

.hud-clock__time {
    font-size: 22px;
    -unity-font-definition: url("project://database/Assets/Orbis/UI/Fonts/LilitaOne/LilitaOne-Regular.ttf");
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(16, 52, 120);
    margin: 0;
    padding: 0;
}

.app .hud-clock__detail {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.85);
    margin: -2px 0 0 0;
    padding: 0;
}

.hud-speed.unity-button,
.hud-speed.unity-button:hover,
.hud-speed.unity-button:active,
.hud-speed.unity-button:focus {
    height: 40px;
    min-width: 62px;
    margin: 0;
    padding: 2px;
    border-width: 0;
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.85);
}

.hud-speed > .candy-face { border-radius: 18px; padding: 0 10px; background-color: rgb(255, 160, 30); border-color: rgb(196, 86, 8); }

.hud-speed__icon {
    width: 16px;
    height: 16px;
    color: rgb(255, 255, 255);
    margin-right: 4px;
}

.hud-speed__label {
    font-size: 16px;
    -unity-font-definition: url("project://database/Assets/Orbis/UI/Fonts/LilitaOne/LilitaOne-Regular.ttf");
    margin: 0;
    padding: 0;
}

.world-loading {
    position: absolute;
    left: 50%;
    top: 46%;
    translate: -50% -50%;
    flex-direction: row;
    align-items: center;
    padding: 12px 22px 12px 14px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.world-loading--visible {
    opacity: 1;
}

.world-loading__icon {
    width: 28px;
    height: 28px;
    color: rgb(255, 255, 255);
    margin-right: 10px;
}

.world-loading__text {
    font-size: 18px;
    white-space: normal;
    max-width: 320px;
}

/* pannello Dettagli: in basso in verticale, a destra in orizzontale e su desktop */
.details {
    position: absolute;
    right: 14px;
    top: 80px;
    bottom: 14px;
    width: 360px;
    padding: 14px 16px 12px 16px;
    translate: 120% 0;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.35s, 0.2s;
    transition-timing-function: ease-out-cubic, linear;
}

.details--visible {
    translate: 0 0;
    opacity: 1;
}

.details > .glass-fill {
    border-radius: 28px;
    --glass-tint-top: rgba(8, 30, 80, 0.80);
    --glass-tint-bottom: rgba(8, 30, 80, 0.88);
    --glass-lip: rgba(0, 16, 50, 0.6);
    --glass-lip-height: 6;
}

.details__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.details__badge {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    margin-right: 12px;
    padding: 2px;
    background-color: rgba(255, 255, 255, 0.85);
}

.details__badge > .candy-face { border-radius: 22px; background-color: rgb(255, 160, 30); border-color: rgb(196, 86, 8); }
.details--landmark .details__badge > .candy-face { background-color: rgb(175, 82, 222); border-color: rgb(110, 44, 150); }

.details__badge-icon {
    width: 26px;
    height: 26px;
    color: rgb(255, 255, 255);
}

.details__titles {
    flex-grow: 1;
    flex-shrink: 1;
}

.details__title {
    font-size: 22px;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Orbis/UI/Fonts/LilitaOne/LilitaOne-Regular.ttf");
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(16, 52, 120);
    margin: 0;
}

.app .details__subtitle {
    font-size: 14px;
    color: rgb(255, 214, 120);
    margin: 0;
    white-space: normal;
}

.details__scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

.details__row {
    flex-direction: row;
    justify-content: space-between;
    padding: 8px 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.12);
}

.app .details__label {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 10px 0 0;
    flex-shrink: 0;
}

.app .details__value {
    font-size: 15px;
    color: rgb(255, 255, 255);
    margin: 0;
    white-space: normal;
    -unity-text-align: upper-right;
    flex-shrink: 1;
}

.app .details__attribution {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.6);
    margin: 8px 0 0 0;
    -unity-text-align: middle-center;
}

.app .hud-attribution {
    position: absolute;
    left: 16px;
    bottom: 1px;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.8);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.7);
}

/* telefono in verticale: pannello dal basso, metà schermo */
.orientation-portrait .details {
    left: 10px;
    right: 10px;
    top: auto;
    bottom: 10px;
    width: auto;
    height: 46%;
    translate: 0 120%;
}

.orientation-portrait .details--visible {
    translate: 0 0;
}

.layout-compact .hud-clock__time { font-size: 19px; }
.layout-compact .hud-button.unity-button { width: 46px; height: 46px; }
.layout-compact .hud-clock { height: 46px; }
.layout-wide .details { width: 400px; }

/* nomi delle strade sulla mappa */
.street-labels {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.app .street-label {
    position: absolute;
    font-size: 12px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-outline-width: 1.2px;
    -unity-text-outline-color: rgba(20, 30, 50, 0.95);
    white-space: nowrap;
    margin: 0;
    padding: 0 4px;
}

/* pannello "livelli" della mappa (nomi delle vie, lotti) */
.layers {
    position: absolute;
    right: 74px;
    top: 128px;
    width: 300px;
    padding: 10px 12px;
    display: none; /* nascosto non deve prendere i tocchi della mappa */
}

.layers--visible {
    display: flex;
}

.layers > .glass-fill {
    border-radius: 22px;
    --glass-tint-top: rgba(8, 30, 80, 0.82);
    --glass-tint-bottom: rgba(8, 30, 80, 0.90);
    --glass-lip: rgba(0, 16, 50, 0.6);
    --glass-lip-height: 4;
}

.layers__row.unity-button {
    margin: 2px 0;
}

.layout-compact .layers {
    right: 64px;
    width: 260px;
}

/* ======================================================================
   M2: cassa, livello, missione, azioni, costruzione, pannelli
   ====================================================================== */

.hud-economy {
    position: absolute;
    left: 14px;
    top: 76px;
    flex-direction: column;
    align-items: flex-start;
}

.hud-pill {
    flex-direction: row;
    align-items: center;
    height: 38px;
    padding: 0 14px 0 8px;
    margin-bottom: 6px;
}

.hud-pill > .glass-fill,
.mission-card > .glass-fill,
.build-bar > .glass-fill,
.game-toast > .glass-fill {
    --glass-tint-top: rgba(8, 30, 80, 0.62);
    --glass-tint-bottom: rgba(8, 30, 80, 0.76);
    --glass-lip: rgba(0, 16, 50, 0.55);
    --glass-lip-height: 3;
}

.hud-pill__icon {
    width: 22px;
    height: 22px;
    margin-right: 6px;
}

.hud-pill__icon--coins { color: rgb(255, 205, 60); }
.hud-pill__icon--star { color: rgb(120, 200, 255); }

.hud-pill__value {
    font-size: 18px;
    -unity-font-definition: url("project://database/Assets/Orbis/UI/Fonts/LilitaOne/LilitaOne-Regular.ttf");
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(16, 52, 120);
}

.xp-bar {
    width: 70px;
    height: 8px;
    margin-left: 8px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.2);
    overflow: hidden;
}

.xp-bar__fill {
    height: 100%;
    width: 0;
    border-radius: 4px;
    background-color: rgb(120, 200, 255);
}

.mission-card.unity-button,
.mission-card.unity-button:hover,
.mission-card.unity-button:active,
.mission-card.unity-button:focus {
    width: 270px;
    margin: 4px 0 0 0;
    padding: 10px 12px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    flex-direction: row;
    align-items: flex-start;
}

.mission-card > .glass-fill { border-radius: 18px; }

.mission-card__icon {
    width: 22px;
    height: 22px;
    color: rgb(255, 160, 30);
    margin-right: 8px;
    margin-top: 2px;
}

.mission-card__texts { flex-grow: 1; flex-shrink: 1; }

.mission-card__title {
    font-size: 16px;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Orbis/UI/Fonts/LilitaOne/LilitaOne-Regular.ttf");
}

.app .mission-card__text {
    display: none;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.88);
    white-space: normal;
    margin-top: 2px;
}

.mission-card--open .mission-card__text { display: flex; }
.mission-card__bar { width: 100%; margin: 6px 0 0 0; }
.mission-card__fill { background-color: rgb(255, 160, 30); }
.mission-card--done { display: none; }

.hud-actions {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 16px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.hud-actions .hud-button.unity-button { margin: 0 5px; }

.hud-build.unity-button,
.hud-build.unity-button:hover,
.hud-build.unity-button:active,
.hud-build.unity-button:focus {
    height: 64px;
    margin: 0 8px;
    padding: 0 22px 0 14px;
    border-width: 0;
    border-radius: 32px;
    background-color: rgba(0, 0, 0, 0);
    flex-direction: row;
    align-items: center;
}

.hud-build { transition-property: scale; transition-duration: 0.15s; transition-timing-function: ease-out-back; }
.hud-build:active { scale: 0.94 0.94; }

.hud-build > .glass-fill {
    --glass-tint-top: rgba(255, 200, 50, 0.95);
    --glass-tint-bottom: rgba(255, 128, 20, 0.92);
    --glass-lip: rgb(196, 86, 8);
    --glass-lip-height: 5;
}

.hud-build__icon { width: 28px; height: 28px; color: rgb(255, 255, 255); margin-right: 8px; }

.hud-build__label {
    font-size: 22px;
    -unity-font-definition: url("project://database/Assets/Orbis/UI/Fonts/LilitaOne/LilitaOne-Regular.ttf");
    -unity-text-outline-width: 1.2px;
    -unity-text-outline-color: rgb(150, 60, 0);
}

.hud-button:disabled { opacity: 0.45; }

.build-bar {
    position: absolute;
    left: 50%;
    bottom: 16px;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    padding: 8px 10px 8px 16px;
    display: none;
    max-width: 96%;
}

.build-bar > .glass-fill { border-radius: 36px; }

.game--building .build-bar { display: flex; }
.game--building .hud-actions { display: none; }
.game--building .mission-card { display: none; }
.game--details .hud-actions { display: none; }

.build-bar__texts { margin-right: 10px; flex-shrink: 1; }

.app .build-bar__name {
    font-size: 17px;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Orbis/UI/Fonts/LilitaOne/LilitaOne-Regular.ttf");
}

.app .build-bar__info { font-size: 13px; color: rgb(170, 255, 190); white-space: normal; }
.app .build-bar--bad .build-bar__info { color: rgb(255, 160, 150); }

.round-button.unity-button,
.round-button.unity-button:hover,
.round-button.unity-button:active,
.round-button.unity-button:focus {
    width: 52px;
    height: 52px;
    margin: 0 4px;
    padding: 2px;
    border-width: 0;
    border-radius: 26px;
    background-color: rgba(255, 255, 255, 0.85);
}

.round-button { transition-property: scale; transition-duration: 0.12s; }
.round-button:active { scale: 0.9 0.9; }
.round-button > .candy-face { border-radius: 24px; }
.round-button--green > .candy-face { background-color: rgb(52, 199, 89); border-color: rgb(28, 128, 54); }
.round-button--blue > .candy-face { background-color: rgb(50, 140, 255); border-color: rgb(20, 80, 180); }
.round-button--red > .candy-face { background-color: rgb(235, 72, 56); border-color: rgb(150, 40, 30); }
.round-button:disabled { opacity: 0.4; }
.round-button__icon { width: 24px; height: 24px; color: rgb(255, 255, 255); }

.game-toast {
    position: absolute;
    left: 50%;
    top: 74px;
    translate: -50% -20px;
    padding: 10px 18px;
    opacity: 0;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
    max-width: 90%;
}

.game-toast > .glass-fill { border-radius: 22px; }
.game-toast--visible { opacity: 1; translate: -50% 0; }
.game-toast__text { font-size: 15px; white-space: normal; -unity-text-align: middle-center; }

/* azioni nel pannello Dettagli */
.details__actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 0 0 6px 0;
}

.action-button.unity-button,
.action-button.unity-button:hover,
.action-button.unity-button:active,
.action-button.unity-button:focus {
    height: 42px;
    margin: 0 6px 6px 0;
    padding: 2px;
    border-width: 0;
    border-radius: 21px;
    background-color: rgba(255, 255, 255, 0.85);
}

.action-button { transition-property: scale; transition-duration: 0.12s; }
.action-button:active { scale: 0.94 0.94; }
.action-button > .candy-face { border-radius: 19px; padding: 0 16px; background-color: rgb(50, 140, 255); border-color: rgb(20, 80, 180); }
.action-button--with-icon > .candy-face { padding: 0 16px 0 12px; }
.action-button--icon-only.unity-button { width: 42px; }
.action-button--icon-only > .candy-face { padding: 0; }
.action-button--primary > .candy-face { background-color: rgb(255, 160, 30); border-color: rgb(196, 86, 8); }
.action-button--danger > .candy-face { background-color: rgb(235, 72, 56); border-color: rgb(150, 40, 30); }
.action-button:disabled { opacity: 0.45; }
.action-button__icon { width: 18px; height: 18px; color: rgb(255, 255, 255); margin-right: 6px; flex-shrink: 0; }
.action-button--icon-only .action-button__icon { width: 20px; height: 20px; margin-right: 0; }
.action-button__label { font-size: 14px; -unity-font-definition: url("project://database/Assets/Orbis/UI/Fonts/LilitaOne/LilitaOne-Regular.ttf"); }

/* pannello generico (catalogo, finanze, riavvolgi, partite) */
.sheet--panel {
    width: 680px;
    height: 86%;
    max-width: 96%;
}

.panel-tabs-scroll { flex-shrink: 0; max-height: 52px; margin-bottom: 6px; }
.panel-tabs { flex-direction: row; }
.panel-tabs--hidden { display: none; }

.panel-tab.unity-button,
.panel-tab.unity-button:hover,
.panel-tab.unity-button:active,
.panel-tab.unity-button:focus {
    height: 38px;
    margin: 0 6px 4px 0;
    padding: 0 14px;
    border-width: 0;
    border-radius: 19px;
    background-color: rgba(255, 255, 255, 0.12);
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-definition: url("project://database/Assets/Orbis/UI/Fonts/LilitaOne/LilitaOne-Regular.ttf");
}

.panel-tab--selected.unity-button { background-color: rgb(255, 160, 30); }
.panel-tabs--wrap { flex-wrap: wrap; }

.panel-scroll { flex-grow: 1; flex-shrink: 1; }
.panel-content { padding-bottom: 8px; }
.panel-footer { flex-direction: row; justify-content: flex-end; margin-top: 8px; flex-shrink: 0; }

.app .panel-section {
    font-size: 16px;
    color: rgb(255, 210, 80);
    margin: 16px 0 4px 4px;
    -unity-font-definition: url("project://database/Assets/Orbis/UI/Fonts/LilitaOne/LilitaOne-Regular.ttf");
}

.app .panel-text { font-size: 14px; color: rgba(255, 255, 255, 0.88); white-space: normal; margin: 4px; }

.panel-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 7px 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.app .panel-row__label { font-size: 14px; color: rgba(255, 255, 255, 0.78); flex-shrink: 1; white-space: normal; }
.app .panel-row__value { font-size: 15px; -unity-text-align: middle-right; }
.app .panel-row__value--plus { color: rgb(140, 240, 150); }
.app .panel-row__value--minus { color: rgb(255, 150, 140); }

.panel-grid { flex-direction: row; flex-wrap: wrap; }

.catalog-card.unity-button,
.catalog-card.unity-button:hover,
.catalog-card.unity-button:active,
.catalog-card.unity-button:focus {
    width: 200px;
    min-height: 92px;
    margin: 0 8px 8px 0;
    padding: 8px 10px;
    border-width: 2px;
    border-radius: 16px;
    border-color: rgba(255, 255, 255, 0.25);
    background-color: rgba(255, 255, 255, 0.09);
    flex-direction: column;
    align-items: flex-start;
}

.input-pointer .catalog-card.unity-button:hover { background-color: rgba(255, 255, 255, 0.18); }
.catalog-card--locked { opacity: 0.55; }
.catalog-card__name { font-size: 15px; white-space: normal; -unity-font-definition: url("project://database/Assets/Orbis/UI/Fonts/LilitaOne/LilitaOne-Regular.ttf"); }
.app .catalog-card__info { font-size: 12px; color: rgba(255, 255, 255, 0.75); white-space: normal; }
.app .catalog-card__cost { font-size: 14px; color: rgb(255, 214, 90); margin-top: 4px; }
.layout-compact .catalog-card.unity-button { width: 47%; }

.panel-field {
    margin: 4px 0 10px 0;
}

.panel-field .unity-text-field__input {
    font-size: 16px;
    border-radius: 12px;
    padding: 8px 12px;
    background-color: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.3);
    color: rgb(255, 255, 255);
}

.layout-compact .hud-economy { top: 68px; }
.layout-compact .mission-card.unity-button { width: 230px; }
.orientation-portrait .mission-card.unity-button { width: 220px; }

/* nuova partita e partite salvate */
.panel-choice { align-self: flex-start; margin: 4px 0 4px 0; }
.panel-choice .segmented__item.unity-button { height: 44px; width: 104px; }
.setting-row.panel-switch.unity-button { margin: 4px 0; padding: 10px 12px; border-radius: 14px; background-color: rgba(255, 255, 255, 0.07); }
.save-card {
    padding: 10px 12px;
    margin: 0 0 10px 0;
    border-radius: 16px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.22);
    background-color: rgba(255, 255, 255, 0.08);
}
.save-card__name { font-size: 18px; -unity-font-definition: url("project://database/Assets/Orbis/UI/Fonts/LilitaOne/LilitaOne-Regular.ttf"); }
.app .save-card__info { font-size: 13px; color: rgba(255, 255, 255, 0.78); white-space: normal; margin: 2px 0 6px 0; }
.save-card__actions { flex-direction: row; justify-content: flex-end; flex-wrap: wrap; }

/* account e cloud (M3) */
.app .save-card__cloud { font-size: 12px; color: rgba(160, 214, 255, 0.95); margin: 0 0 6px 0; -unity-font-style: bold; }
.app .account-name { font-size: 26px; color: rgb(255, 255, 255); -unity-font-style: bold; margin: 4px 4px 0 4px; white-space: normal; }
.app .panel-text--error { color: rgb(255, 196, 120); -unity-font-style: bold; }
.app .panel-text--notice {
    color: rgb(255, 255, 255);
    background-color: rgba(255, 170, 60, 0.22);
    border-radius: 12px;
    padding: 8px 10px;
}
.panel-actions { flex-direction: row; justify-content: flex-start; flex-wrap: wrap; margin: 2px 0 8px 0; }

/* telefono: la barra in basso deve stare nei 375-393 punti di larghezza */
.layout-compact .hud-actions .hud-button.unity-button { width: 46px; height: 46px; margin: 0 3px 10px 3px; }
.layout-compact .hud-build.unity-button { height: 58px; margin: 0 5px; padding: 0 14px 0 10px; }
.layout-compact .hud-build__icon { width: 22px; height: 22px; margin-right: 6px; }
.layout-compact .hud-build__label { font-size: 18px; }

/* barra di costruzione: i testi si stringono e vanno a capo, i bottoni restano interi */
.build-bar__texts { flex-grow: 1; flex-shrink: 1; min-width: 0; overflow: hidden; }
.build-bar .round-button { flex-shrink: 0; }
.layout-compact .build-bar { width: 96%; }

/* aliquote: valore e −/+ insieme a destra */
.tax-controls { flex-direction: row; align-items: center; flex-shrink: 0; }
.app .tax-controls .panel-row__value { margin-right: 4px; min-width: 56px; }
.tax-controls .action-button.unity-button,
.tax-controls .action-button.unity-button:hover,
.tax-controls .action-button.unity-button:active,
.tax-controls .action-button.unity-button:focus { margin: 0 0 0 8px; }

/* catalogo: tre colonne su tablet e desktop, due sul telefono */
.catalog-card.unity-button { width: 31.5%; }
.layout-compact .catalog-card.unity-button { width: 47%; }

/* barre di scorrimento sottili (le frecce di sistema non servono: si trascina o si usa la rotella) */
.app .unity-scroller__low-button,
.app .unity-scroller__high-button { display: none; }
.app .unity-scroll-view__vertical-scroller { width: 6px; margin-left: 4px; }
.app .unity-scroll-view__horizontal-scroller { height: 6px; }
.app .unity-scroller .unity-base-slider__tracker { background-color: rgba(255, 255, 255, 0.08); border-width: 0; border-radius: 3px; }
.app .unity-scroller .unity-base-slider__dragger { background-color: rgba(255, 255, 255, 0.45); border-width: 0; border-radius: 3px; }
.app .unity-scroller .unity-base-slider__dragger-border { display: none; }
.app .unity-scroller--vertical .unity-base-slider__dragger { left: 0; width: 6px; }
.app .unity-scroller--horizontal .unity-base-slider__dragger { top: 0; height: 6px; }
.app .unity-scroller .unity-base-slider__drag-container { margin: 0; }

/* anteprima 3D dell'elemento nella scheda del catalogo */
.catalog-card__preview {
    width: 100%;
    height: 92px;
    margin: 4px 0 4px 0;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.12);
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0.4;
    transition-property: opacity;
    transition-duration: 0.2s;
}
.catalog-card__preview--ready { opacity: 1; }
.layout-compact .catalog-card__preview { height: 104px; }
.catalog-card--locked .catalog-card__preview { opacity: 0.55; }
