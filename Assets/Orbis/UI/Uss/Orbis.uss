/*
 * Orbis — stile dell'interfaccia: da gioco, colorato e "cicciotto", con bottoni e navbar in liquid glass.
 * 1 px USS = 1 punto logico (vedi AdaptiveLayout). Classi di layout sull'elemento .app:
 * layout-compact (telefono), layout-medium (tablet), layout-wide (desktop), orientation-portrait,
 * input-touch / input-pointer.
 * Nota: il progetto è in spazio colore lineare, quindi le velature bianche semitrasparenti schiariscono
 * molto: per questo le tinte bianche del vetro hanno alfa bassa.
 */

/* ---------- Base ---------- */

.app {
    flex-grow: 1;
    color: rgb(255, 255, 255);
    font-size: 15px;
}

.backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    transition-property: opacity;
    transition-duration: 1.2s;
    transition-timing-function: ease-in-out-sine;
}

/* quando la città 3D è pronta lo sfondo fisso sfuma e la si vede */
.backdrop--hidden {
    opacity: 0;
}

.vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.safe-area {
    flex-grow: 1;
}

.app Label {
    padding: 0;
    margin: 0;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

/* font da gioco (Lilita One, OFL) per titoli, bottoni ed etichette */
.wordmark,
.game-button__label,
.nav-item__label,
.toast__text,
.loading__percent,
.tip__title {
    -unity-font-definition: url("project://database/Assets/Orbis/UI/Fonts/LilitaOne/LilitaOne-Regular.ttf");
    -unity-font-style: normal;
}

/* ---------- Schermate e transizioni ---------- */

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-cubic;
}

.screen--visible {
    opacity: 1;
}

/* ---------- Logo e marchio ---------- */

.logo {
    flex-shrink: 0;
    --logo-color: rgb(255, 255, 255);
    --logo-accent: rgb(255, 196, 60);
    --logo-fill: rgba(10, 40, 90, 0.55);
}

.wordmark {
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2.5px;
    -unity-text-outline-color: rgb(16, 52, 120);
    text-shadow: 0 4px 0 rgba(10, 30, 80, 0.75);
    letter-spacing: 1px;
}

.tagline {
    font-size: 16px;
    -unity-font-style: bold;
    margin-top: 2px;
    -unity-text-outline-width: 1.2px;
    -unity-text-outline-color: rgba(10, 30, 80, 0.85);
    text-shadow: 0 2px 4px rgba(0, 10, 40, 0.6);
}

/* ---------- Logo iniziale ---------- */

.splash {
    align-items: center;
    justify-content: center;
}

.logo--splash {
    width: 176px;
    height: 176px;
    scale: 0.6 0.6;
    transition-property: scale;
    transition-duration: 0.9s;
    transition-timing-function: ease-out-back;
}

.splash.screen--visible .logo--splash {
    scale: 1 1;
}

.wordmark--splash {
    font-size: 72px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 3px;
}

.tagline--splash {
    -unity-text-align: middle-center;
    font-size: 18px;
}

/* ---------- Caricamento ---------- */

.loading {
    align-items: center;
    justify-content: center;
}

.loading__center {
    align-items: center;
}

.logo--loading {
    width: 112px;
    height: 112px;
}

.wordmark--loading {
    font-size: 48px;
    -unity-text-align: middle-center;
}

.progress {
    width: 320px;
    height: 30px;
    margin-top: 22px;
    padding: 6px;
}

.progress > .glass-fill {
    --glass-tint-top: rgba(8, 30, 80, 0.45);
    --glass-tint-bottom: rgba(8, 30, 80, 0.55);
    --glass-lip: rgba(0, 18, 50, 0.45);
    --glass-lip-height: 3;
    --glass-shadow-spread: 10;
    --glass-shadow-offset: 4;
}

.progress__track {
    flex-grow: 1;
    border-radius: 999px;
    overflow: hidden;
}

.progress__fill {
    width: 0;
    height: 100%;
    border-radius: 999px;
    background-color: rgb(255, 160, 30);
    border-bottom-width: 3px;
    border-color: rgb(214, 104, 8);
}

.progress__shine {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 3px;
    height: 35%;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.35);
}

.loading__row {
    flex-direction: row;
    justify-content: space-between;
    width: 308px;
    margin-top: 10px;
}

.loading__status {
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(10, 30, 80, 0.8);
}

.loading__percent {
    font-size: 18px;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(16, 52, 120);
}

.tip {
    position: absolute;
    bottom: 24px;
    align-self: center;
    max-width: 560px;
    padding: 12px 22px 14px 22px;
    align-items: center;
}

.tip > .glass-fill {
    border-radius: 22px;
    --glass-tint-top: rgba(8, 30, 80, 0.40);
    --glass-tint-bottom: rgba(8, 30, 80, 0.52);
}

.tip__title {
    font-size: 16px;
    color: rgb(255, 210, 80);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1.2px;
    -unity-text-outline-color: rgb(120, 60, 0);
}

.app .tip__text {
    font-size: 14px;
    margin-top: 3px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ---------- Menu principale ---------- */

.menu {
    padding: 20px 40px 104px 40px;
}

.menu__content {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.menu__hero {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    translate: -30px 0;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.8s, 0.6s;
    transition-timing-function: ease-out-back, ease-out-cubic;
}

.menu.screen--visible .menu__hero {
    translate: 0 0;
    opacity: 1;
}

.logo--hero {
    width: 120px;
    height: 120px;
    margin-right: 6px;
}

.wordmark--hero {
    font-size: 68px;
}

.menu__actions {
    width: 310px;
    flex-shrink: 0;
    translate: 0 40px;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.75s, 0.5s;
    transition-delay: 0.1s, 0.1s;
    transition-timing-function: ease-out-back, ease-out-cubic;
}

.menu.screen--visible .menu__actions {
    translate: 0 0;
    opacity: 1;
}

/* ---------- Superfici di vetro ---------- */

.glass-fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 999px;
    --glass-tint-top: rgba(255, 255, 255, 0.06);
    --glass-tint-bottom: rgba(255, 255, 255, 0);
    --glass-rim-top: rgba(255, 255, 255, 0.75);
    --glass-rim-bottom: rgba(255, 255, 255, 0.10);
    --glass-rim-width: 1.6;
    --glass-shadow: rgba(0, 10, 40, 0.35);
    --glass-shadow-spread: 14;
    --glass-shadow-offset: 8;
    --glass-lip: rgba(0, 0, 0, 0);
    --glass-lip-height: 0;
}

/* ---------- Bottoni da gioco (capsule di vetro colorato con spessore) ---------- */

.game-button.unity-button,
.game-button.unity-button:hover,
.game-button.unity-button:active,
.game-button.unity-button:focus,
.game-button.unity-button:disabled {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 999px;
    margin: 0 0 18px 0;
    padding: 0 24px 0 10px;
    height: 74px;
    flex-direction: row;
    align-items: center;
    -unity-text-align: middle-left;
    color: rgb(255, 255, 255);
}

.game-button {
    transition-property: scale, translate;
    transition-duration: 0.18s, 0.08s;
    transition-timing-function: ease-out-back, ease-out-cubic;
}

.input-pointer .game-button:hover {
    scale: 1.04 1.04;
}

.game-button:active {
    scale: 0.97 0.97;
    translate: 0 4px;
}

.game-button > .glass-fill {
    --glass-lip-height: 6;
}

.game-button:active > .glass-fill {
    --glass-lip-height: 2;
}

/* disattivato: il vetro resta, si attenua solo il contenuto */
.game-button:disabled > .game-button__badge,
.game-button:disabled > .game-button__texts {
    opacity: 0.5;
}

.input-pointer .game-button:focus > .glass-fill {
    --glass-rim-top: rgba(255, 255, 255, 1);
    --glass-rim-bottom: rgba(255, 255, 255, 0.7);
    --glass-rim-width: 3;
}

/* principale: arancio dorato */
.game-button--primary > .glass-fill {
    --glass-tint-top: rgba(255, 200, 50, 0.93);
    --glass-tint-bottom: rgba(255, 128, 20, 0.90);
    --glass-rim-top: rgba(255, 255, 255, 0.95);
    --glass-rim-bottom: rgba(255, 220, 160, 0.35);
    --glass-lip: rgb(196, 86, 8);
    --glass-shadow: rgba(120, 50, 0, 0.45);
}

.input-pointer .game-button--primary:hover > .glass-fill {
    --glass-tint-top: rgba(255, 214, 80, 0.96);
    --glass-tint-bottom: rgba(255, 142, 30, 0.93);
}

/* secondario: blu cielo */
.game-button--secondary > .glass-fill {
    --glass-tint-top: rgba(70, 180, 255, 0.78);
    --glass-tint-bottom: rgba(24, 110, 240, 0.72);
    --glass-lip: rgb(14, 66, 160);
}

.game-button__badge {
    width: 52px;
    height: 52px;
    border-radius: 26px;
    margin-right: 14px;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.28);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.75);
}

.game-button__icon {
    width: 24px;
    height: 24px;
    color: rgb(255, 255, 255);
}

.game-button__texts {
    flex-grow: 1;
    justify-content: center;
}

.game-button__label {
    font-size: 26px;
    -unity-text-outline-width: 1.6px;
    -unity-text-outline-color: rgba(90, 40, 0, 0.85);
    text-shadow: 0 2px 0 rgba(90, 40, 0, 0.55);
}

.game-button--secondary .game-button__label {
    -unity-text-outline-color: rgba(10, 40, 110, 0.9);
    text-shadow: 0 2px 0 rgba(10, 40, 110, 0.55);
}

.game-button__detail {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.92);
    margin-top: 0;
}

/* ---------- Navbar fluttuante ---------- */

.navbar {
    position: absolute;
    bottom: 16px;
    align-self: center;
    flex-direction: row;
    padding: 6px 10px 8px 10px;
    translate: 0 60px;
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: 0.8s, 0.5s;
    transition-delay: 0.2s, 0.2s;
    transition-timing-function: ease-out-back, ease-out-cubic;
}

.navbar > .glass-fill {
    border-radius: 30px;
    /* vetro fumé: le etichette bianche restano leggibili anche sopra la città chiara */
    --glass-tint-top: rgba(8, 30, 80, 0.38);
    --glass-tint-bottom: rgba(8, 30, 80, 0.50);
    --glass-lip: rgba(0, 20, 60, 0.45);
    --glass-lip-height: 4;
}

.menu.screen--visible .navbar {
    translate: 0 0;
    opacity: 1;
}

.nav-item.unity-button,
.nav-item.unity-button:hover,
.nav-item.unity-button:active,
.nav-item.unity-button:focus {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 20px;
    margin: 0 2px;
    padding: 4px 0 2px 0;
    width: 96px;
    height: 74px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: rgb(255, 255, 255);
}

.nav-item {
    transition-property: scale, translate;
    transition-duration: 0.18s, 0.08s;
    transition-timing-function: ease-out-back, ease-out-cubic;
}

.input-pointer .nav-item:hover {
    scale: 1.08 1.08;
}

.input-pointer .nav-item.unity-button:focus {
    background-color: rgba(255, 255, 255, 0.07);
}

.nav-item:active {
    scale: 0.92 0.92;
    translate: 0 2px;
}

.nav-item__badge {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: rgba(255, 255, 255, 0.85);
}

.nav-item--friends .nav-item__badge { background-color: rgb(52, 199, 89); border-bottom-color: rgb(28, 128, 54); }
.nav-item--settings .nav-item__badge { background-color: rgb(175, 82, 222); border-bottom-color: rgb(110, 44, 150); }
.nav-item--credits .nav-item__badge { background-color: rgb(255, 159, 10); border-bottom-color: rgb(196, 100, 0); }

.nav-item__icon {
    width: 22px;
    height: 22px;
    color: rgb(255, 255, 255);
}

.nav-item__label {
    font-size: 13px;
    margin-top: 4px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1.2px;
    -unity-text-outline-color: rgba(10, 30, 80, 0.85);
}

/* ---------- Avviso (toast) ---------- */

.toast {
    position: absolute;
    top: 14px;
    align-self: center;
    flex-direction: row;
    align-items: center;
    height: 50px;
    padding: 0 22px 0 16px;
    opacity: 0;
    translate: 0 -40px;
    scale: 0.8 0.8;
    transition-property: opacity, translate, scale;
    transition-duration: 0.25s, 0.5s, 0.5s;
    transition-timing-function: ease-out-cubic, ease-out-back, ease-out-back;
}

.toast--visible {
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
}

.toast > .glass-fill {
    --glass-tint-top: rgba(255, 200, 50, 0.92);
    --glass-tint-bottom: rgba(255, 140, 20, 0.88);
    --glass-lip: rgb(196, 86, 8);
    --glass-lip-height: 4;
}

.toast__icon {
    width: 22px;
    height: 22px;
    margin-right: 10px;
    color: rgb(255, 255, 255);
}

.toast__text {
    font-size: 18px;
    -unity-text-outline-width: 1.4px;
    -unity-text-outline-color: rgba(90, 40, 0, 0.85);
}

/* ---------- Versione ---------- */

.version {
    position: absolute;
    right: 18px;
    bottom: 10px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.75);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}

/* ---------- Tablet ---------- */

.layout-medium .logo--hero { width: 150px; height: 150px; }
.layout-medium .wordmark--hero { font-size: 88px; }
.layout-medium .tagline { font-size: 19px; }
.layout-medium .menu__actions { width: 350px; }
.layout-medium .game-button.unity-button { height: 82px; }
.layout-medium .game-button__label { font-size: 28px; }
.layout-medium .menu { padding: 32px 56px 120px 56px; }
.layout-medium .navbar { bottom: 22px; }
.layout-medium .nav-item.unity-button { width: 108px; height: 80px; }
.layout-medium .nav-item__badge { width: 50px; height: 50px; border-radius: 25px; }

/* ---------- Desktop ---------- */

.layout-wide .logo--hero { width: 180px; height: 180px; margin-right: 12px; }
.layout-wide .wordmark--hero { font-size: 112px; -unity-text-outline-width: 3.5px; }
.layout-wide .tagline { font-size: 22px; }
.layout-wide .menu__actions { width: 400px; }
.layout-wide .game-button.unity-button { height: 88px; padding: 0 28px 0 12px; }
.layout-wide .game-button__label { font-size: 32px; }
.layout-wide .game-button__badge { width: 60px; height: 60px; border-radius: 30px; }
.layout-wide .menu { padding: 48px 10% 140px 8%; }
.layout-wide .navbar { bottom: 28px; }
.layout-wide .nav-item.unity-button { width: 116px; height: 84px; }
.layout-wide .nav-item__badge { width: 52px; height: 52px; border-radius: 26px; }
.layout-wide .nav-item__label { font-size: 15px; }
.layout-wide .logo--splash { width: 220px; height: 220px; }
.layout-wide .wordmark--splash { font-size: 96px; }

/* ---------- Verticale (browser del telefono, menu nel telefono di gioco) ---------- */

.orientation-portrait .menu { padding: 40px 24px 112px 24px; }
.orientation-portrait .menu__content { flex-direction: column; justify-content: space-between; }
.orientation-portrait .menu__hero { flex-direction: column; translate: 0 -20px; }
.orientation-portrait.app .menu.screen--visible .menu__hero { translate: 0 0; }
.orientation-portrait .logo--hero { margin-right: 0; margin-bottom: 2px; }
.orientation-portrait .menu__titles { align-items: center; }
.orientation-portrait .wordmark--hero { -unity-text-align: middle-center; }
.orientation-portrait .tagline { -unity-text-align: middle-center; }
.orientation-portrait .menu__actions { width: 100%; max-width: 360px; }
.orientation-portrait .version { top: 10px; bottom: auto; }
.orientation-portrait .tip { max-width: 92%; }
