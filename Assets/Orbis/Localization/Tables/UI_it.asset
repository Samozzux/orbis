    m_Metadata:
      m_Items: []
  - m_Id: 422209381195912
    m_Localized: Ottimo!
    m_Metadata:
      m_Items: []
  - m_Id: 422209381195913
    m_Localized: '{0} g e {1} h'
    m_Metadata:
