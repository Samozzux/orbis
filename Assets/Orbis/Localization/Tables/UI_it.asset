    m_Localized: rende felici
    m_Metadata:
      m_Items: []
  - m_Id: 422209381195792
    m_Localized: "Clic per costruire \xB7 R ruota \xB7 Esc annulla"
    m_Metadata:
      m_Items: []
  - m_Id: 422209381195793
    m_Localized: "Sposta la mappa per scegliere il punto, poi \u2713"
    m_Metadata:
      m_Items: []
  - m_Id: 422209381195794
    m_Localized: 'Cantiere aperto: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 422209381195795
    m_Localized: "Si pu\xF2 costruire qui"
    m_Metadata:
      m_Items: []
  - m_Id: 422209381195796
    m_Localized: "Qui non si pu\xF2: scegli un lotto libero (non su strade o piazze)"
    m_Metadata:
      m_Items: []
  - m_Id: 422209381195797
    m_Localized: "Lo spazio \xE8 occupato da un edificio o da un altro elemento"
    m_Metadata:
      m_Items: []
  - m_Id: 422209381195798
    m_Localized: 'Non ancora sbloccato: sali di livello'
    m_Metadata:
      m_Items: []
