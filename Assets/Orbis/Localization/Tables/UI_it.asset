  m_TableData:
  - m_Id: 464510976
    m_Localized: Orbis
    m_Metadata:
      m_Items: []
  - m_Id: 481288192
    m_Localized: "La tua citt\xE0, nel mondo vero."
    m_Metadata:
      m_Items: []
  - m_Id: 481288193
    m_Localized: "Preparo i testi\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 481288194
    m_Localized: "Preparo il dispositivo\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 481288195
    m_Localized: "Carico i contenuti\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 481288196
    m_Localized: "Preparo il mondo\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 481288197
    m_Localized: Pronto
    m_Metadata:
      m_Items: []
  - m_Id: 481288198
    m_Localized: Continua
    m_Metadata:
      m_Items: []
  - m_Id: 481288199
    m_Localized: Nessuna partita salvata
    m_Metadata:
      m_Items: []
  - m_Id: 481288200
    m_Localized: Riprendi l'ultima partita
    m_Metadata:
      m_Items: []
  - m_Id: 481288201
    m_Localized: Nuova partita
    m_Metadata:
      m_Items: []
  - m_Id: 481288202
    m_Localized: Parti da Chieti
    m_Metadata:
      m_Items: []
  - m_Id: 481288203
    m_Localized: Amici
    m_Metadata:
      m_Items: []
  - m_Id: 481288204
    m_Localized: Impostazioni
    m_Metadata:
      m_Items: []
  - m_Id: 481288205
    m_Localized: Crediti
    m_Metadata:
      m_Items: []
  - m_Id: 481288206
    m_Localized: In arrivo nelle prossime versioni
    m_Metadata:
      m_Items: []
  - m_Id: 481288207
    m_Localized: Versione {0} ({1})
    m_Metadata:
      m_Items: []
  - m_Id: 481288208
    m_Localized: Orbis usa Face ID per farti entrare senza password.
    m_Metadata:
      m_Items: []
  - m_Id: 481288209
    m_Localized: "Orbis pu\xF2 riprodurre i brani della tua libreria musicale durante il gioco."
    m_Metadata:
      m_Items: []
  - m_Id: 481288210
    m_Localized: Orbis salva nella tua libreria le foto scattate nel gioco.
    m_Metadata:
      m_Items: []
  - m_Id: 481288211
    m_Localized: Caricamento
    m_Metadata:
      m_Items: []
  - m_Id: 481288212
    m_Localized: "Questo browser non pu\xF2 avviare Orbis: serve WebGPU o WebGL 2. Usa una versione recente di Safari, Chrome, Edge o Firefox."
    m_Metadata:
      m_Items: []
  - m_Id: 481288213
    m_Localized: "Non \xE8 stato possibile avviare Orbis. Ricarica la pagina per riprovare."
    m_Metadata:
      m_Items: []
  - m_Id: 481288214
    m_Localized: "Simulatore di citt\xE0 e di vita ambientato nel mondo reale, a partire da Chieti."
    m_Metadata:
      m_Items: []
  - m_Id: 32717612769280
    m_Localized: '{0}%'
    m_Metadata:
      m_Items: []
  - m_Id: 32717633740800
    m_Localized: Lo sapevi?
    m_Metadata:
      m_Items: []
  - m_Id: 32717633740801
    m_Localized: Chieti sorge su un colle tra la Majella e il mare Adriatico.
    m_Metadata:
      m_Items: []
  - m_Id: 32717633740802
    m_Localized: "Chieti \xE8 tra le citt\xE0 pi\xF9 antiche d'Italia: i Romani la chiamavano Teate."
    m_Metadata:
      m_Items: []
  - m_Id: 32717633740803
    m_Localized: In Orbis potrai essere sindaco o semplice cittadino, e cambiare ruolo quando vuoi.
    m_Metadata:
      m_Items: []
  - m_Id: 32717633740804
    m_Localized: Strade ed edifici di Orbis arriveranno dalle mappe vere di OpenStreetMap.
    m_Metadata:
      m_Items: []
  - m_Id: 73679407931392
    m_Localized: Impostazioni
    m_Metadata:
      m_Items: []
  - m_Id: 73679420514304
    m_Localized: Schermo
    m_Metadata:
      m_Items: []
  - m_Id: 73679420514305
    m_Localized: Rotazione automatica
    m_Metadata:
      m_Items: []
  - m_Id: 73679420514306
    m_Localized: Il gioco gira insieme al telefono o al tablet
    m_Metadata:
      m_Items: []
  - m_Id: 73679420514307
    m_Localized: Orientamento
    m_Metadata:
      m_Items: []
  - m_Id: 73679420514308
    m_Localized: Spegni la rotazione automatica per scegliere
    m_Metadata:
      m_Items: []
  - m_Id: 73679420514309
    m_Localized: Verticale
    m_Metadata:
      m_Items: []
  - m_Id: 73679420514310
    m_Localized: Orizzontale
    m_Metadata:
      m_Items: []
  - m_Id: 73679424708608
    m_Localized: Nel browser lo schermo segue come tieni il dispositivo. Nell'app per iPhone, iPad e Android puoi bloccarlo in verticale o in orizzontale.
    m_Metadata:
      m_Items: []
  - m_Id: 73679424708609
    m_Localized: Altre impostazioni in arrivo nelle prossime versioni.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
