    m_Localized: Stato
    m_Metadata:
      m_Items: []
  - m_Id: 422209381195858
    m_Localized: In funzione
    m_Metadata:
      m_Items: []
  - m_Id: 422209381195859
    m_Localized: Lavori in corso, pronto {0}
    m_Metadata:
      m_Items: []
  - m_Id: 422209381195860
    m_Localized: Abitanti
    m_Metadata:
      m_Items: []
  - m_Id: 422209381195861
    m_Localized: Posti di lavoro
    m_Metadata:
